[user]
	email = ${GIT_USER_EMAIL}
	name = ${GIT_SCREEN_NAME}
	signingkey = ~/.ssh/${MACHINE_USERNAME}.pub
[core]
	editor = code --wait
	excludesfile = ~/.gitignore
[alias]
	br = branch
	ch = checkout
	chb = ch -b
	cm = commit --no-edit
	cma = cm --amend
	cmn = cm --no-verify
	cmr = cm --reuse-message=HEAD
	cp = cherry-pick
	dd = add .
	develop = "!f() { git fh && git ch develop && git ll; }; f"
	fh = fetch --all --prune
	lg = log --oneline -n 15
	ll = pull
	mg = merge --no-edit --no-ff
	ph = push -u
	pha = ph --all
	st = status
	staging = "!f() { git fh && git ch staging && git ll; }; f"
	sw = switch
	wa = worktree add
	wl = worktree list
	wp = worktree prune
	wr = worktree remove
[push]
	autoSetupRemote = true
	default = current
[pull]
	default = current
[submodule]
	recurse = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
